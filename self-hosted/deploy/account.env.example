RUSTDESK_ACCOUNT_BIND=0.0.0.0:21114
RUSTDESK_ACCOUNT_DB=/opt/rustdesk-selfhost/account/data/account.sqlite3
RUSTDESK_ACCOUNT_TLS_CERT=/opt/rustdesk-selfhost/tls/server.crt
RUSTDESK_ACCOUNT_TLS_KEY=/opt/rustdesk-selfhost/tls/server.key
RUSTDESK_ACCOUNT_MASTER_KEY=replace-with-base64-encoded-32-byte-key
