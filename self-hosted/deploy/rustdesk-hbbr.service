[Unit]
Description=RustDesk relay server
After=network-online.target rustdesk-hbbs.service
Wants=network-online.target

[Service]
Type=simple
User=rustdesk-selfhost
Group=rustdesk-selfhost
WorkingDirectory=/opt/rustdesk-selfhost/server/data
Environment=HOME=/opt/rustdesk-selfhost/server/data
ExecStart=/opt/rustdesk-selfhost/server/bin/hbbr -p 21117 -k _
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/rustdesk-selfhost/server/data

[Install]
WantedBy=multi-user.target
